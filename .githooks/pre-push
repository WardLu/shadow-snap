#!/bin/sh
# ---- remote CI worker (advisory) -------------------------------------------------
# Queue the pushed commit on the self-hosted worker in the background: it never blocks or
# fails the push, DEVKIT_CI_SKIP_HOOK=1 turns it off, and nothing happens when `devkit` is
# not on PATH. The ref list arrives on stdin, so capture it once and hand the same bytes to
# the checks below.
_refs_file="$(mktemp)"
trap 'rm -f "$_refs_file"' EXIT INT TERM
cat > "$_refs_file"
if [ "${DEVKIT_CI_SKIP_HOOK:-0}" != 1 ] && command -v devkit >/dev/null 2>&1; then
  while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    case "$_remote_ref" in
      refs/heads/main|refs/heads/production)
        _sha="$(git rev-parse "$_local_sha^{commit}" 2>/dev/null)" || continue
        _log="$(git rev-parse --git-path devkit-ci-enqueue.log 2>/dev/null || echo /tmp/devkit-ci-enqueue.log)"
        ( nohup devkit ci enqueue WardLu/shadow-snap --sha "$_sha" --checks gate >>"$_log" 2>&1 & ) >/dev/null 2>&1 || true
        printf 'pre-push: queued %.7s on the remote CI worker (log: %s)\n' "$_sha" "$_log" >&2
        ;;
    esac
  done < "$_refs_file"
fi
exec 0<"$_refs_file"
# ---- end remote CI worker --------------------------------------------------------

# Advisory: `git push --no-verify` bypasses it; the authoritative gate is the release script.
# - Tags must look like vX.Y.Z.
# - Pushing the release branch requires a valid local CI record for the pushed commit, checked by
#   scripts/ci/local-ci.mjs verify (templates/ci/local-ci.mjs inside shadow-devkit itself).
# Uses only git, node and files inside the repository. Activate with: git config core.hooksPath .githooks
set -eu

for tool in git node; do
  command -v "$tool" >/dev/null 2>&1 || { echo "pre-push: $tool not found" >&2; exit 1; }
done

root=$(git rev-parse --show-toplevel)
verifier="$root/scripts/ci/local-ci.mjs"
[ -f "$verifier" ] || verifier="$root/templates/ci/local-ci.mjs"

branch=$(node -e '
  const fs = require("fs");
  const file = process.argv[1] + "/config/release-production.json";
  if (!fs.existsSync(file)) { console.log("main"); process.exit(0); }
  const value = JSON.parse(fs.readFileSync(file, "utf8")).productionBranch;
  if (typeof value !== "string" || !value) process.exit(1);
  console.log(value);
' "$root") || { echo "pre-push: config/release-production.json has no valid productionBranch" >&2; exit 1; }

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/tags/*)
      tag=${remote_ref#refs/tags/}
      if ! printf '%s\n' "$tag" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "pre-push: tag '$tag' does not match vX.Y.Z" >&2
        status=1
      fi
      ;;
    "refs/heads/$branch")
      sha=$(git rev-parse "$local_sha^{commit}")
      if [ ! -f "$verifier" ]; then
        echo "pre-push: local CI verifier not found ($verifier)" >&2
        status=1
      elif ! node "$verifier" verify "$sha" >&2; then
        echo "pre-push: no valid local CI record for $branch at ${sha%"${sha#???????}"}" >&2
        echo "Run 'node scripts/ci/local-ci.mjs run' on a clean worktree first (it records the credential)." >&2
        status=1
      fi
      ;;
  esac
done
exit "$status"
