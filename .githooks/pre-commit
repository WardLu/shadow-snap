#!/bin/sh
# Advisory: refuses to commit credential files. `git commit --no-verify` bypasses it;
# the authoritative gates are the release script and review.
# Activate with: git config core.hooksPath .githooks
set -eu

command -v git >/dev/null 2>&1 || { echo "pre-commit: git not found" >&2; exit 1; }

# Kept out of $(...): macOS /bin/sh (bash 3.2) misparses `case` inside command substitution.
credential_files() {
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    name=${file##*/}
    case "$name" in
      *.example|*.sample|*.template) continue ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|id_rsa|id_ed25519|id_ecdsa|id_dsa) printf '%s\n' "$file" ;;
    esac
  done
}

blocked=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | credential_files)

if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit credential files:" >&2
  printf '%s\n' "$blocked" | sed 's/^/  /' >&2
  echo "Unstage them (git restore --staged <file>) and keep secrets out of the repository." >&2
  exit 1
fi
