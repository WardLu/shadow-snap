#!/bin/sh
# Advisory: refuses to commit credential files. `git commit --no-verify` bypasses it;
# the authoritative gates are the release script and CI.
# Activate with: git config core.hooksPath .githooks
set -eu

command -v git >/dev/null 2>&1 || { echo "pre-commit: git not found" >&2; exit 1; }

# Kept out of $(...): macOS /bin/sh (bash 3.2) misparses `case` inside command substitution.
credential_files() {
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    name=${file##*/}
    case "$name" in
      *.example|*.sample|*.template) continue ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|id_rsa|id_ed25519|id_ecdsa|id_dsa) printf '%s\n' "$file" ;;
    esac
  done
}

blocked=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | credential_files)

if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit credential files:" >&2
  printf '%s\n' "$blocked" | sed 's/^/  /' >&2
  echo "Unstage them (git restore --staged <file>) and keep secrets out of the repository." >&2
  exit 1
fi

# Secrets inside ordinary files: a commit is the last point where removal leaves no history.
# The full-history scan in the local equivalent gate (config/local-ci.json) stays authoritative.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact --verbose --log-level warn .; then
    echo "pre-commit: gitleaks found secrets in staged changes (values redacted above)." >&2
    echo "Move them to an ignored .env*.local file and reference the variable name instead." >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks not installed, staged secret scan skipped (brew install gitleaks)." >&2
fi
